@page "/order-confirmation/{OrderId:guid}"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Storefront.Web.RealTime
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<PageTitle>Order Confirmation - CritterSupply</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" data-testid="order-confirmation-loading" />
}
else if (_orderNotFound)
{
    <MudAlert Severity="Severity.Error" data-testid="order-not-found">Order not found.</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-4">
        Return to Home
    </MudButton>
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-4" data-testid="order-confirmation-panel">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mr-2" />
                    <div>
                        <MudText Typo="Typo.h4">Order Confirmed!</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Thank you for your order</MudText>
                    </div>
                </div>

                <MudDivider Class="my-4" />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.h6" Class="mb-2">Order Details</MudText>
                        <div class="d-flex mb-2">
                            <MudText Typo="Typo.body2" Class="mr-2" Style="font-weight: 600;">Order ID:</MudText>
                            <MudText Typo="Typo.body2" data-testid="order-id">@OrderId</MudText>
                        </div>
                        <div class="d-flex mb-2">
                            <MudText Typo="Typo.body2" Class="mr-2" Style="font-weight: 600;">Status:</MudText>
                            <MudChip T="string" Color="@GetStatusColor(_currentStatus)" Size="Size.Small" data-testid="order-status">@GetDisplayStatus(_currentStatus)</MudChip>
                        </div>
                        <div class="d-flex mb-2">
                            <MudText Typo="Typo.body2" Class="mr-2" Style="font-weight: 600;">Order Date:</MudText>
                            <MudText Typo="Typo.body2" data-testid="order-date">@DateTime.UtcNow.ToString("MMMM dd, yyyy")</MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        @if (_sseConnected)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2" data-testid="signalr-connected">
                                <MudIcon Icon="@Icons.Material.Filled.Wifi" Class="mr-2" />
                                Receiving real-time order updates
                            </MudAlert>
                        }

                        @if (!string.IsNullOrEmpty(_latestUpdate))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" data-testid="order-update-notification">
                                @_latestUpdate
                            </MudAlert>
                        }
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6" Class="mb-2">What's Next?</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CreditCard">
                        Payment processing will complete within minutes
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory">
                        Your order will be prepared for shipment
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.LocalShipping">
                        Track your shipment progress right here once your order ships
                    </MudListItem>
                </MudList>

                <MudDivider Class="my-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/products" Class="mr-2">
                    Continue Shopping
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/orders">
                    View Order History
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private bool _isLoading = true;
    private bool _orderNotFound = false;
    private bool _sseConnected = false;
    private string _currentStatus = "Placed";
    private string? _latestUpdate = null;
    private DotNetObjectReference<OrderConfirmation>? _dotNetHelper;
    private Guid? _customerId;

    protected override async Task OnInitializedAsync()
    {
        // Get authenticated customer ID (optional - order confirmation page can be viewed by anyone with order ID)
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var customerIdClaim = authState.User.FindFirst("CustomerId")?.Value;
            if (Guid.TryParse(customerIdClaim, out var customerId))
            {
                _customerId = customerId;
            }
        }

        await LoadOrderStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only subscribe to SSE if authenticated and on first render
        if (firstRender && _customerId.HasValue)
        {
            await SubscribeToSSE();
        }
    }

    private async Task LoadOrderStatus()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("StorefrontApi");
            var response = await client.GetAsync($"/api/storefront/orders/{OrderId}");

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _orderNotFound = true;
            }
            else if (response.IsSuccessStatusCode)
            {
                // Parse order status from response
                // For now, default to "Placed" status
                _currentStatus = "Placed";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load order status: {ex.Message}");
            // Still show confirmation page even if status fetch fails
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubscribeToSSE()
    {
        if (!_customerId.HasValue) return;

        try
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            // Build the hub URL from configuration so E2E tests can point to their test API server.
            // Falls back to the default local port when the config key is absent.
            var apiBaseUrl = Configuration["ApiClients:StorefrontApiUrl"] ?? "http://localhost:5237";
            var hubUrl = $"{apiBaseUrl}/hub/storefront";
            await JS.InvokeVoidAsync("signalrClient.subscribe", _customerId.Value.ToString(), _dotNetHelper, hubUrl);
            _sseConnected = true;
            // OnAfterRenderAsync does NOT trigger a re-render when state is mutated —
            // StateHasChanged() must be called explicitly to make the signalr-connected
            // indicator appear in the DOM.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to subscribe to SignalR: {ex.Message}");
            _sseConnected = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnSseEvent(JsonElement eventData)
    {
        Console.WriteLine($"SSE event received: {eventData}");

        var eventTypeName = StorefrontEventReader.GetEventType(eventData);
        if (eventTypeName is null)
        {
            return;
        }

        switch (eventTypeName)
        {
            case "order-placed":
                _currentStatus = "Placed";
                _latestUpdate = "Order placed successfully";
                StateHasChanged();
                break;

            case "order-status-changed":
                // Handles OrderStatusChanged events routed via Wolverine SignalR transport.
                var orderNewStatus = StorefrontEventReader.GetString(eventData, "newStatus");
                if (orderNewStatus is not null)
                {
                    _currentStatus = orderNewStatus;
                    _latestUpdate = $"Order status updated to {_currentStatus}";
                }
                StateHasChanged();
                break;

            case "payment-confirmed":
                _currentStatus = "Payment Confirmed";
                _latestUpdate = "Payment processed successfully";
                StateHasChanged();
                break;

            case "shipment-status-changed":
                // 20+ shipment notification handlers (Backordered, HandedToCarrier,
                // Delivered, LostInTransit, ReturnToSender, DeliveryAttemptFailed, etc.)
                // all flow through this discriminator; NewStatus tells us which.
                var shipNewStatus = StorefrontEventReader.GetString(eventData, "newStatus");
                if (shipNewStatus is not null)
                {
                    _currentStatus = StorefrontStatusMapper.MapShipmentStatus(shipNewStatus);
                    var trackingNumber = StorefrontEventReader.GetString(eventData, "trackingNumber");
                    _latestUpdate = StorefrontStatusMapper.BuildShipmentMessage(shipNewStatus, trackingNumber);
                }
                else
                {
                    _currentStatus = "Shipped";
                    _latestUpdate = "Order has been shipped";
                }
                StateHasChanged();
                break;

            case "return-status-changed":
                // 8 Returns notification handlers all flow through this
                // discriminator; NewStatus distinguishes them.
                var returnStatus = StorefrontEventReader.GetString(eventData, "newStatus");
                if (returnStatus is not null)
                {
                    _currentStatus = $"Return: {returnStatus}";
                    var details = StorefrontEventReader.GetString(eventData, "details");
                    _latestUpdate = StorefrontStatusMapper.BuildReturnMessage(returnStatus, details);
                }
                StateHasChanged();
                break;

            case "return-exchange-payment-changed":
                // Cross-product-exchange payment update — capture (more-expensive
                // replacement) or refund (cheaper replacement). M47.0 / Slice 3
                // surfaces the payment metadata added in Slice 2.
                var paymentKind = StorefrontEventReader.GetString(eventData, "paymentKind") ?? "";
                var amount = StorefrontEventReader.GetDecimal(eventData, "amount") ?? 0m;
                var currency = StorefrontEventReader.GetString(eventData, "currency") ?? "";
                var paymentReference = StorefrontEventReader.GetString(eventData, "paymentReference");
                _currentStatus = "Exchange Payment Updated";
                _latestUpdate = StorefrontStatusMapper.BuildExchangePaymentMessage(
                    paymentKind, amount, currency, paymentReference);
                StateHasChanged();
                break;

            case "shipment-dispatched":
                _currentStatus = "Shipped";
                var dispatchTracking = StorefrontEventReader.GetString(eventData, "trackingNumber");
                _latestUpdate = string.IsNullOrEmpty(dispatchTracking)
                    ? "Order has been shipped"
                    : $"Order shipped! Tracking: {dispatchTracking}";
                StateHasChanged();
                break;

            case "shipment-delivered":
                _currentStatus = "Delivered";
                _latestUpdate = "Order delivered successfully";
                StateHasChanged();
                break;

            case "shipment-delivery-failed":
                _currentStatus = "Delivery Failed";
                _latestUpdate = "Your delivery was unsuccessful — our team has been notified. Please check your order for next steps.";
                StateHasChanged();
                break;
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Placed" => Color.Info,
        "Payment Confirmed" => Color.Success,
        "Preparing for Shipment" => Color.Info,
        "Shipped" => Color.Primary,
        "Out for Delivery" => Color.Primary,
        "Delivered" => Color.Success,
        "Delivery Failed" => Color.Error,
        "Backordered" => Color.Warning,
        "Lost in Transit" => Color.Error,
        "Returning to Sender" => Color.Warning,
        "Exchange Payment Updated" => Color.Success,
        // M47.0 / Slice 4 — exchange cancellation is a "things broke"
        // outcome (UXE direction). Render the chip in Error to match the
        // Delivery Failed / Lost in Transit family rather than the
        // generic Return: warning.
        "Return: Cancelled" => Color.Error,
        var s when s.StartsWith("Return:") => Color.Warning,
        _ => Color.Default
    };

    private static string GetDisplayStatus(string domainStatus) => domainStatus switch
    {
        "Placed" => "Order Received",
        "PaymentAuthorized" or "Payment Confirmed" => "Payment Confirmed",
        "InventoryReserved" => "Preparing Your Order",
        "Preparing for Shipment" => "Preparing for Shipment",
        "Shipped" => "Shipped",
        "Out for Delivery" => "Out for Delivery",
        "Delivered" => "Delivered",
        "Delivery Failed" => "Delivery Issue",
        "Backordered" => "Backordered",
        "Lost in Transit" => "Lost in Transit",
        "Returning to Sender" => "Returning to Sender",
        "Exchange Payment Updated" => "Exchange Payment Updated",
        // M47.0 / Slice 4 — friendlier label than the raw "Return: Cancelled".
        "Return: Cancelled" => "Exchange Cancelled",
        var s when s.StartsWith("Return:") => s,
        _ => "Processing"  // Safe consumer fallback for any unexpected domain status
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("signalrClient.unsubscribe");
            _dotNetHelper?.Dispose();
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}
