@page "/order-confirmation/{OrderId:guid}"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<PageTitle>Order Confirmation - CritterSupply</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" data-testid="order-confirmation-loading" />
}
else if (_orderNotFound)
{
    <MudAlert Severity="Severity.Error" data-testid="order-not-found">Order not found.</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-4">
        Return to Home
    </MudButton>
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-4" data-testid="order-confirmation-panel">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mr-2" />
                    <div>
                        <MudText Typo="Typo.h4">Order Confirmed!</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Thank you for your order</MudText>
                    </div>
                </div>

                <MudDivider Class="my-4" />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.h6" Class="mb-2">Order Details</MudText>
                        <div class="d-flex mb-2">
                            <MudText Typo="Typo.body2" Class="mr-2" Style="font-weight: 600;">Order ID:</MudText>
                            <MudText Typo="Typo.body2" data-testid="order-id">@OrderId</MudText>
                        </div>
                        <div class="d-flex mb-2">
                            <MudText Typo="Typo.body2" Class="mr-2" Style="font-weight: 600;">Status:</MudText>
                            <MudChip T="string" Color="@GetStatusColor(_currentStatus)" Size="Size.Small" data-testid="order-status">@GetDisplayStatus(_currentStatus)</MudChip>
                        </div>
                        <div class="d-flex mb-2">
                            <MudText Typo="Typo.body2" Class="mr-2" Style="font-weight: 600;">Order Date:</MudText>
                            <MudText Typo="Typo.body2" data-testid="order-date">@DateTime.UtcNow.ToString("MMMM dd, yyyy")</MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        @if (_sseConnected)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2" data-testid="signalr-connected">
                                <MudIcon Icon="@Icons.Material.Filled.Wifi" Class="mr-2" />
                                Receiving real-time order updates
                            </MudAlert>
                        }

                        @if (!string.IsNullOrEmpty(_latestUpdate))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" data-testid="order-update-notification">
                                @_latestUpdate
                            </MudAlert>
                        }
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6" Class="mb-2">What's Next?</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CreditCard">
                        Payment processing will complete within minutes
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory">
                        Your order will be prepared for shipment
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.LocalShipping">
                        Track your shipment progress right here once your order ships
                    </MudListItem>
                </MudList>

                <MudDivider Class="my-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/products" Class="mr-2">
                    Continue Shopping
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/orders">
                    View Order History
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private bool _isLoading = true;
    private bool _orderNotFound = false;
    private bool _sseConnected = false;
    private string _currentStatus = "Placed";
    private string? _latestUpdate = null;
    private DotNetObjectReference<OrderConfirmation>? _dotNetHelper;
    private Guid? _customerId;

    protected override async Task OnInitializedAsync()
    {
        // Get authenticated customer ID (optional - order confirmation page can be viewed by anyone with order ID)
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var customerIdClaim = authState.User.FindFirst("CustomerId")?.Value;
            if (Guid.TryParse(customerIdClaim, out var customerId))
            {
                _customerId = customerId;
            }
        }

        await LoadOrderStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only subscribe to SSE if authenticated and on first render
        if (firstRender && _customerId.HasValue)
        {
            await SubscribeToSSE();
        }
    }

    private async Task LoadOrderStatus()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("StorefrontApi");
            var response = await client.GetAsync($"/api/storefront/orders/{OrderId}");

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _orderNotFound = true;
            }
            else if (response.IsSuccessStatusCode)
            {
                // Parse order status from response
                // For now, default to "Placed" status
                _currentStatus = "Placed";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load order status: {ex.Message}");
            // Still show confirmation page even if status fetch fails
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubscribeToSSE()
    {
        if (!_customerId.HasValue) return;

        try
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            // Build the hub URL from configuration so E2E tests can point to their test API server.
            // Falls back to the default local port when the config key is absent.
            var apiBaseUrl = Configuration["ApiClients:StorefrontApiUrl"] ?? "http://localhost:5237";
            var hubUrl = $"{apiBaseUrl}/hub/storefront";
            await JS.InvokeVoidAsync("signalrClient.subscribe", _customerId.Value.ToString(), _dotNetHelper, hubUrl);
            _sseConnected = true;
            // OnAfterRenderAsync does NOT trigger a re-render when state is mutated —
            // StateHasChanged() must be called explicitly to make the signalr-connected
            // indicator appear in the DOM.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to subscribe to SignalR: {ex.Message}");
            _sseConnected = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnSseEvent(JsonElement eventData)
    {
        Console.WriteLine($"SSE event received: {eventData}");

        // Parse event type
        if (eventData.TryGetProperty("eventType", out var eventType))
        {
            var eventTypeName = eventType.GetString();

            switch (eventTypeName)
            {
                case "order-placed":
                    _currentStatus = "Placed";
                    _latestUpdate = "Order placed successfully";
                    StateHasChanged();
                    break;

                case "order-status-changed":
                    // Handles OrderStatusChanged events routed via Wolverine SignalR transport.
                    // SignalR serializes with camelCase (System.Text.Json web defaults), and
                    // signalr-client.js spreads cloudEvent.data before invoking OnSseEvent —
                    // so property names arrive here in camelCase.
                    if (eventData.TryGetProperty("newStatus", out var newStatus))
                    {
                        _currentStatus = newStatus.GetString() ?? _currentStatus;
                        _latestUpdate = $"Order status updated to {_currentStatus}";
                    }
                    StateHasChanged();
                    break;

                case "payment-confirmed":
                    _currentStatus = "Payment Confirmed";
                    _latestUpdate = "Payment processed successfully";
                    StateHasChanged();
                    break;

                case "shipment-status-changed":
                    // Handles ShipmentStatusChanged events routed via Wolverine SignalR transport.
                    // Properties arrive in camelCase — see order-status-changed comment above.
                    // 20+ shipment notification handlers (Backordered, HandedToCarrier, Delivered,
                    // LostInTransit, ReturnToSender, DeliveryAttemptFailed, etc.) all flow through
                    // this single discriminator; the NewStatus payload tells us which one.
                    if (eventData.TryGetProperty("newStatus", out var shipNewStatus))
                    {
                        var statusValue = shipNewStatus.GetString() ?? "Shipped";
                        _currentStatus = MapShipmentStatus(statusValue);
                        eventData.TryGetProperty("trackingNumber", out var trackingSignalR);
                        var trackingNumber = trackingSignalR.ValueKind == JsonValueKind.String ? trackingSignalR.GetString() : null;
                        _latestUpdate = BuildShipmentMessage(statusValue, trackingNumber);
                    }
                    else
                    {
                        _currentStatus = "Shipped";
                        _latestUpdate = "Order has been shipped";
                    }
                    StateHasChanged();
                    break;

                case "return-status-changed":
                    // Handles ReturnStatusChanged events. Returns notification handlers
                    // (ReturnRequested/Approved/Denied/Received/Completed/Rejected/Expired/ToSender)
                    // all flow through this discriminator; NewStatus distinguishes them.
                    if (eventData.TryGetProperty("newStatus", out var returnStatus))
                    {
                        var statusValue = returnStatus.GetString() ?? "Returned";
                        _currentStatus = $"Return: {statusValue}";
                        eventData.TryGetProperty("details", out var detailsElement);
                        var details = detailsElement.ValueKind == JsonValueKind.String ? detailsElement.GetString() : null;
                        _latestUpdate = BuildReturnMessage(statusValue, details);
                    }
                    StateHasChanged();
                    break;

                case "shipment-dispatched":
                    _currentStatus = "Shipped";
                    if (eventData.TryGetProperty("trackingNumber", out var tracking))
                    {
                        _latestUpdate = $"Order shipped! Tracking: {tracking.GetString()}";
                    }
                    else
                    {
                        _latestUpdate = "Order has been shipped";
                    }
                    StateHasChanged();
                    break;

                case "shipment-delivered":
                    _currentStatus = "Delivered";
                    _latestUpdate = "Order delivered successfully";
                    StateHasChanged();
                    break;

                case "shipment-delivery-failed":
                    _currentStatus = "Delivery Failed";
                    _latestUpdate = "Your delivery was unsuccessful — our team has been notified. Please check your order for next steps.";
                    StateHasChanged();
                    break;
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Placed" => Color.Info,
        "Payment Confirmed" => Color.Success,
        "Preparing for Shipment" => Color.Info,
        "Shipped" => Color.Primary,
        "Out for Delivery" => Color.Primary,
        "Delivered" => Color.Success,
        "Delivery Failed" => Color.Error,
        "Backordered" => Color.Warning,
        "Lost in Transit" => Color.Error,
        "Returning to Sender" => Color.Warning,
        var s when s.StartsWith("Return:") => Color.Warning,
        _ => Color.Default
    };

    private static string GetDisplayStatus(string domainStatus) => domainStatus switch
    {
        "Placed" => "Order Received",
        "PaymentAuthorized" or "Payment Confirmed" => "Payment Confirmed",
        "InventoryReserved" => "Preparing Your Order",
        "Preparing for Shipment" => "Preparing for Shipment",
        "Shipped" => "Shipped",
        "Out for Delivery" => "Out for Delivery",
        "Delivered" => "Delivered",
        "Delivery Failed" => "Delivery Issue",
        "Backordered" => "Backordered",
        "Lost in Transit" => "Lost in Transit",
        "Returning to Sender" => "Returning to Sender",
        var s when s.StartsWith("Return:") => s,
        _ => "Processing"  // Safe consumer fallback for any unexpected domain status
    };

    /// <summary>
    /// Maps the raw <c>NewStatus</c> from <c>ShipmentStatusChanged</c> SignalR events
    /// to a customer-friendly status label. Covers the full set of shipment notification
    /// handlers wired in <c>Storefront/Notifications/</c>.
    /// </summary>
    internal static string MapShipmentStatus(string newStatus) => newStatus switch
    {
        "Backordered" => "Backordered",
        "HandedToCarrier" or "InTransit" => "Shipped",
        "OutForDelivery" => "Out for Delivery",
        "Delivered" => "Delivered",
        "DeliveryAttemptFailed" => "Delivery Failed",
        "LostInTransit" => "Lost in Transit",
        "ReturnToSenderInitiated" => "Returning to Sender",
        "TrackingNumberAssigned" => "Preparing for Shipment",
        _ => newStatus  // pass-through preserves any new statuses without UI changes
    };

    /// <summary>
    /// Builds the customer-facing message line for a shipment status change.
    /// </summary>
    internal static string BuildShipmentMessage(string newStatus, string? trackingNumber) => newStatus switch
    {
        "Backordered" => "This item is currently backordered — we'll notify you with an updated shipping estimate as soon as stock is available.",
        "HandedToCarrier" or "InTransit" =>
            string.IsNullOrEmpty(trackingNumber)
                ? "Your order is on its way to the carrier."
                : $"Your order is in transit. Tracking: {trackingNumber}",
        "TrackingNumberAssigned" =>
            string.IsNullOrEmpty(trackingNumber)
                ? "A tracking number has been assigned to your order."
                : $"Tracking number assigned: {trackingNumber}",
        "OutForDelivery" => "Your order is out for delivery today.",
        "Delivered" => "Order delivered successfully.",
        "DeliveryAttemptFailed" => "A delivery attempt was unsuccessful — the carrier will retry.",
        "LostInTransit" => "We've detected an issue with this shipment and have opened a carrier trace. Our team will follow up shortly.",
        "ReturnToSenderInitiated" => "The carrier is returning this shipment to our warehouse. We'll arrange a reshipment and contact you with details.",
        _ => string.IsNullOrEmpty(trackingNumber)
            ? $"Shipment update: {newStatus}"
            : $"Shipment update: {newStatus} (Tracking: {trackingNumber})"
    };

    /// <summary>
    /// Builds the customer-facing message line for a return status change.
    /// Mirrors the 8 Returns notification handlers in <c>Storefront/Notifications/</c>.
    /// </summary>
    internal static string BuildReturnMessage(string newStatus, string? details) => newStatus switch
    {
        "Requested" => "We've received your return request and are reviewing it.",
        "Approved" => "Your return has been approved — please ship the item back using the instructions provided.",
        "Denied" => string.IsNullOrEmpty(details)
            ? "Your return request was denied. Please contact support for more information."
            : $"Your return request was denied: {details}",
        "Received" => "We've received your returned item and are inspecting it.",
        "Completed" => "Your return has been completed and your refund processed.",
        "Rejected" => string.IsNullOrEmpty(details)
            ? "Your returned item failed inspection. Please contact support."
            : $"Your returned item failed inspection: {details}",
        "Expired" => "Your return window has expired. Please contact support if you need assistance.",
        _ => string.IsNullOrEmpty(details)
            ? $"Return update: {newStatus}"
            : $"Return update: {newStatus} — {details}"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("signalrClient.unsubscribe");
            _dotNetHelper?.Dispose();
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}
